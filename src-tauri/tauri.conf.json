{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EternalLauncher",
  "identifier": "org.eternaltwin.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EternalLauncher",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "publisher": "EternalTwin",
    "copyright": "EternalTwin",
    "category": "Game",
    "shortDescription": "Launcher de bureau des jeux EternalTwin",
    "longDescription": "Installe, met à jour et lance les jeux EternalTwin qui se jouent hors du navigateur.",
    "homepage": "https://github.com/eternaltwin/EternalLauncher",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French", "Spanish", "German", "PortugueseBR"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
